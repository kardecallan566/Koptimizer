<Window x:Class="Koptimizer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Koptimizer" Height="720" Width="1120" MinHeight="640" MinWidth="900" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterScreen"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#141D28" Padding="22"><StackPanel><TextBlock Text="KOPTIMIZER" FontSize="22" FontWeight="Bold"/><TextBlock Text="Performance center" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,34"/><TextBlock Text="VISÃO GERAL" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="◈  Dashboard" FontSize="15" Margin="0,12,0,28"/><TextBlock Text="MÓDULOS" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="Gaming" FontSize="15" Margin="0,14,0,12"/><TextBlock Text="Windows" FontSize="15" Margin="0,0,0,12"/><TextBlock Text="IA Local" FontSize="15"/><TextBlock Text="DIAGNÓSTICO SOMENTE LEITURA" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="0,50,0,0"/><TextBlock Text="Esta versão não altera configurações." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border><ScrollViewer Grid.Column="1"><StackPanel Margin="32"><TextBlock Text="Painel de desempenho" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Visão inicial do computador e dos três módulos integrados." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,28"/><TextBlock Text="ESTADO DO SISTEMA" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/><UniformGrid Columns="3" Margin="0,0,0,26"><Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="Processadores lógicos" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="CpuValue" Text="..." FontSize="25" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border><Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="Memória em uso" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="MemoryValue" Text="..." FontSize="25" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock x:Name="MemoryDetail" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel></Border><Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16"><StackPanel><TextBlock Text="Processos ativos" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ProcessValue" Text="..." FontSize="25" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border></UniformGrid><TextBlock Text="TRÊS FRENTES, UM ÚNICO SOFTWARE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/><UniformGrid Columns="3"><Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="GAMING" FontWeight="Bold"/><TextBlock Text="Perfis de jogos, gráficos, latência e benchmarks." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12"/><TextBlock Text="Planejado" Foreground="{StaticResource AccentBrush}" FontSize="11"/></StackPanel></Border><Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="WINDOWS" FontWeight="Bold"/><TextBlock Text="Inicialização, processos, armazenamento e manutenção." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12"/><TextBlock Text="Diagnóstico inicial" Foreground="{StaticResource AccentBrush}" FontSize="11"/></StackPanel></Border><Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16"><StackPanel><TextBlock Text="IA LOCAL" FontWeight="Bold"/><TextBlock Text="Ollama, modelos, memória, VRAM e inferência." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12"/><TextBlock Text="Planejado" Foreground="{StaticResource AccentBrush}" FontSize="11"/></StackPanel></Border></UniformGrid><Border Background="#1C2D2A" CornerRadius="10" Padding="16" Margin="0,24,0,0"><StackPanel><TextBlock Text="Segurança em primeiro lugar" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/><TextBlock Text="Esta versão apenas coleta informações. Não altera serviços, registro, plano de energia, drivers ou configurações do Windows." TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border><TextBlock x:Name="SystemInfo" Text="Coletando informações..." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,16,0,0" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Grid></Window>